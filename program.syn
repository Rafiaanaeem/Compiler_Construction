begin

make age = 18;
whole marks = 85;
decimal average = 87.5;
text name = "Rafia";
flag passed = true;

show name;
show age;
show average;

set age = 20;

when passed do
    show "Student passed";
otherwise
    show "Student failed";
stop

while age > 0 do
    show age;
    set age = age - 1;
stop

repeat 3 times
    show "Hello";
stop

define whole add(whole a, whole b)
    give a + b;
stop

show add(5, 10);

finish